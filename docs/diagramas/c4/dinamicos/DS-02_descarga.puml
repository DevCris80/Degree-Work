@startuml DS-02_descarga
!include <C4/C4_Sequence>
UpdateLegendTitle("Leyenda")
SetDefaultLegendEntries("person\nexternal_system\ncontainer\ncomponent")
UpdateElementStyle("person", $legendText="Actor externo")
UpdateElementStyle("external_system", $legendText="Dispositivo externo (integrado o simulado)")
UpdateElementStyle("container", $legendText="Contenedor implementado")
UpdateElementStyle("component", $legendText="Componente implementado")
AddElementTag("parcial", $bgColor="#f3d27a", $fontColor="#222222", $borderColor="#9a7b1c", $legendText="Parcial (existe, falta parte del alcance)")
AddElementTag("planificado", $bgColor="#d9e2ec", $fontColor="#222222", $borderColor="#5a6b7d", $borderStyle=DashedLine(), $legendText="Planificado")
autonumber
skinparam wrapWidth 320

title [Dinámico DS-02] Mecanismo de sincronización 2: descarga incremental por cursor (CU-20, RF-36, RF-38, RNF-09)

Container_Boundary(app, "App MiGanado")
  Component(motor, "DAT-05 Motor de sincronización", "WorkManager", $tags="planificado")
  Component(repos, "DAT-01 Repositorios locales", "Room", $tags="parcial")
  Component(fotos, "DAT-06 Gestor de fotos", "FileProvider, WebP", $tags="parcial")
Boundary_End()
Container_Boundary(api, "API de sincronización (FastAPI)")
  Component(descarga, "API-05 Endpoint de descarga", "FastAPI", $tags="planificado")
  Component(jwt, "API-01 Verificador de JWT", "FastAPI", $tags="planificado")
  Component(sesDb, "API-06 Sesión de BD del usuario", "SQLAlchemy/asyncpg", $tags="planificado")
Boundary_End()
ContainerDb(pg, "Base de datos central", "PostgreSQL con RLS", $tags="planificado")
Container(storage, "Almacenamiento de fotos", "Supabase Storage", $tags="planificado")

Rel(motor, repos, "Lee el último cursor recibido (después de terminar la subida)")
Rel(motor, descarga, "Pide los cambios con cursor mayor que el último, con margen de solapamiento", "HTTPS/JSON + JWT")
Rel(descarga, jwt, "Valida el JWT")
Rel(descarga, sesDb, "Consulta por cursor con la identidad del usuario")
Rel(sesDb, pg, "Filas posteriores al cursor; RLS deja solo las de su finca", "SQL")
Rel(descarga, motor, "Devuelve las filas, sus rev y el nuevo cursor", "HTTPS/JSON")
Rel(motor, repos, "Aplica por id y rev sin duplicar; guarda el cursor y la fecha de la última sincronización")
Rel(motor, fotos, "Pide las fotos nuevas de los animales recibidos")
Rel(fotos, storage, "Descarga las fotos WebP", "HTTPS + JWT")

note over motor, repos
  Regla de aplicación: una fila local con sincronizado = false no se sobrescribe con la descargada. Conserva su rev_base, y en la siguiente subida el servidor decide si es sibling.
end note

SHOW_LEGEND()
@enduml
