@startuml C3_componentes_bd
!include <C4/C4_Component>

title [Nivel 3] Diagrama de componentes — Base de datos central (Supabase)

UpdateLegendTitle("Leyenda")
SetDefaultLegendEntries("container\ncomponent")
UpdateElementStyle("container", $legendText="Otro contenedor de MiGanado")
UpdateElementStyle("component", $legendText="Componente implementado")
AddElementTag("parcial", $bgColor="#f3d27a", $fontColor="#222222", $borderColor="#9a7b1c", $legendText="Componente parcial (existe, falta parte del alcance)")
AddElementTag("planificado", $bgColor="#d9e2ec", $fontColor="#222222", $borderColor="#5a6b7d", $borderStyle=DashedLine(), $legendText="Componente o contenedor planificado")
AddRelTag("planificado", $lineStyle=DashedLine(), $legendText="Comunicación planificada (línea punteada)")

Container(app, "App MiGanado", "Kotlin, Jetpack Compose")
Container(auth, "Supabase Auth", "GoTrue")
Container(rest, "API de datos", "PostgREST", "Verifica el JWT y ejecuta cada función con el rol authenticated y los claims del usuario.")

Container_Boundary(pg, "Base de datos central (PostgreSQL con RLS)") {
  Component(subida, "BD-01 subir_cambios", "Función PL/pgSQL, SECURITY INVOKER", "Recibe un lote de filas (las editables con rev_base e id_version) y devuelve un resultado por fila.")
  Component(revisiones, "BD-02 Control de revisiones", "PL/pgSQL", "Lee la revisión vigente con FOR UPDATE y compara rev_base: acepta con rev + 1 o guarda un sibling. Reconoce un id_version ya procesado, aplica la baja sobre la vigente y marca resueltos los siblings que nombra una resolución.")
  Component(resultados, "BD-03 Clasificador de resultados", "PL/pgSQL", "Traduce errores de unicidad (RN-01, RN-21) y de permisos (RLS) en rechazos con motivo, sin abortar el lote.")
  Component(descarga, "BD-04 descargar_cambios", "Función PL/pgSQL, SECURITY INVOKER", "Devuelve una página de filas con cursor mayor que el recibido, con margen de solapamiento, los siblings sin resolver y el nuevo cursor.")
  Component(rls, "BD-05 Políticas RLS", "PostgreSQL", "Filtran cada tabla por finca y rol. Ninguna permite DELETE.")
  Component(finca, "BD-06 Funciones de finca", "PL/pgSQL, SECURITY DEFINER", "Estado: parcial. crear_finca corre en un trigger sobre auth.users al registrarse y crea la finca, su primer Ganadero y la aceptación de datos en la misma transacción. Faltan generar_invitacion, canjear_invitacion y quitar_operario, con su tabla de invitaciones.", $tags="parcial")
  ComponentDb(tablas, "BD-07 Tablas", "PostgreSQL", "Datos de las fincas con su cursor (secuencia global), revisiones, siblings y aceptaciones de datos.")
}

Rel(app, auth, "Crea la cuenta, con el nombre de la finca y la versión de la autorización como metadatos, e inicia sesión", "HTTPS")
Rel(app, rest, "Llama subir_cambios y descargar_cambios", "HTTPS/JSON + JWT")
Rel(app, rest, "Gestiona invitaciones", "HTTPS/JSON + JWT", $tags="planificado")
Rel(auth, finca, "Al registrarse, un trigger llama crear_finca", "SQL")
Rel(rest, auth, "Verifica con la clave de firma de Supabase Auth")
Rel(rest, subida, "Ejecuta como el usuario")
Rel(rest, descarga, "Ejecuta como el usuario")
Rel(rest, finca, "Ejecutará las funciones de invitación", $tags="planificado")
Rel(subida, revisiones, "Procesa cada fila")
Rel(revisiones, resultados, "Clasifica el resultado de cada fila")
Rel(revisiones, tablas, "Lee la revisión vigente y escribe", "SQL")
Rel(descarga, tablas, "Consulta por cursor", "SQL")
Rel(rls, tablas, "Restringe las filas por finca y rol")
Rel(finca, tablas, "Crea la finca, el primer Usuario y la aceptación de datos", "SQL")

SHOW_LEGEND()
@enduml
