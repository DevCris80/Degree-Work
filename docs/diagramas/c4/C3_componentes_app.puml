@startuml C3_componentes_app
!include <C4/C4_Component>

title [Nivel 3] Diagrama de componentes — App MiGanado

UpdateLegendTitle("Leyenda")
SetDefaultLegendEntries("external_system\ncontainer\ncomponent")
UpdateElementStyle("external_system", $legendText="Dispositivo externo (integrado o simulado)")
UpdateElementStyle("container", $legendText="Otro contenedor de MiGanado")
UpdateElementStyle("component", $legendText="Componente implementado")
AddElementTag("parcial", $bgColor="#f3d27a", $fontColor="#222222", $borderColor="#9a7b1c", $legendText="Componente parcial (existe, falta parte del alcance)")
AddElementTag("planificado", $bgColor="#d9e2ec", $fontColor="#222222", $borderColor="#5a6b7d", $borderStyle=DashedLine(), $legendText="Componente o contenedor planificado")
AddRelTag("planificado", $lineStyle=DashedLine(), $legendText="Comunicación planificada (línea punteada)")

System_Ext(chapeta, "Chapeta NFC", "NTAG215, 13,56 MHz")
System_Ext(bascula, "Báscula IoT (ESP32)", "UID y peso simulados")

Container_Boundary(app, "App MiGanado (Kotlin, Jetpack Compose)") {

  Boundary(ui, "Capa de presentación (pantallas Compose + ViewModel)", "paquete ui") {
    Component(uiCuenta, "UI-01 Cuenta y acceso", "Compose, ViewModel", "Estado: parcial. Crear cuenta con la autorización Ley 1581, iniciar sesión y recuperar la contraseña. Falta canjear un código de invitación.", $tags="parcial")
    Component(uiAnimales, "UI-02 Animales", "Compose, ViewModel", "Estado: parcial. Lista, detalle con historial y genealogía, registro, edición, baja y liberación de chapeta. Falta asociar chapeta.", $tags="parcial")
    Component(uiEscanear, "UI-03 Escanear", "Compose, NfcAdapter (modo lector NFC-A)", "Lee el UID de la chapeta y decide el destino del código.")
    Component(uiPesajes, "UI-04 Pesajes", "Compose, ViewModel", "Inicia y detiene el servicio de pesaje, concilia pendientes y registra el pesaje manual. Oculta al Operario lo que su rol no permite.")
    Component(uiEventos, "UI-05 Eventos", "Compose, ViewModel", "Estado: parcial. Lista de los eventos de la finca, con los programados primero, y registro con fecha pasada o futura y los campos de vacunación y parto. Faltan edición y baja.", $tags="parcial")
    Component(uiFinca, "UI-06 Finca y usuarios", "Compose, ViewModel, ubicación del sistema", "Estado: parcial. Ubicación de la finca, que solo registra el Ganadero. Faltan la invitación y quitar un Operario.", $tags="parcial")
    Component(uiSync, "UI-07 Sincronización", "Compose, ViewModel", "Aviso en la lista de los cambios por subir, en conflicto o rechazados, botón para sincronizar, resolución de conflictos y bandeja de rechazos.")
    Component(uiInd, "UI-08 Indicadores", "Compose, ViewModel", "Inventario, evolución de peso, pendientes, eventos por mes y completitud del historial, calculados sobre Room.")
  }

  Boundary(dom, "Capa de dominio (módulo :domain, Kotlin puro)", "módulo Gradle") {
    Component(domCuenta, "DOM-01 Cuenta y permisos", "Kotlin", "CrearCuenta y la política de permisos por rol (Rol.puedeAdministrar), que se verifica sin señal.")
    Component(domAnimales, "DOM-02 Animales y chapetas", "Kotlin", "Estado: parcial. RegistrarAnimal (con padre y madre), ActualizarAnimal, DarDeBajaAnimal, LiberarChapeta, ResolverDestinoEscaneo y normalización del código. Falta asociar chapeta.", $tags="parcial")
    Component(domPesajes, "DOM-03 Pesajes", "Kotlin", "RegistrarPesaje (idempotente, hora = recepción − antiguedad_ms), RegistrarPesajeManual, asignar y descartar pendientes.")
    Component(domEventos, "DOM-04 Eventos y revisiones", "Kotlin", "Estado: parcial. RegistrarEvento (campos de cada tipo y cría del parto) y ResolverConflicto. Faltan edición con rev_base y baja lógica de eventos y pesajes.", $tags="parcial")
    Component(domInd, "DOM-05 Indicadores", "Kotlin", "ObservarIndicadoresHato y ObservarEvolucionPeso: inventario, ganancia diaria de peso, pendientes, eventos por mes y completitud del historial.")
  }

  Boundary(data, "Capa de datos (paquete data y service)", "paquete") {
    Component(repos, "DAT-01 Repositorios locales", "Room DAO, transacciones", "Única puerta a Room: escribe con sincronizado = false, fechaModificacion y los campos de revisión (rev, revBase, idVersion). Guarda también los siblings, los rechazos y el estado de sincronización.")
    Component(srvPesaje, "DAT-02 Servidor de pesajes", "NanoHTTPD en servicio en primer plano", "POST /pesaje en el puerto 8080: valida el cuerpo y responde 201, 202, 400, 503 o 500.")
    Component(sesion, "DAT-03 Sesión y autenticación", "supabase-kt Auth, almacenamiento cifrado con Android Keystore", "Guarda y renueva el JWT fuera de Room.")
    Component(funciones, "DAT-04 Funciones de finca", "supabase-kt PostgREST (rpc)", "Llamará generar_invitacion, canjear_invitacion y quitar_operario. Crear la cuenta no pasa por aquí: la finca la crea el servidor al registrarse (DAT-03).", $tags="planificado")
    Component(motorSync, "DAT-05 Motor de sincronización", "WorkManager, supabase-kt PostgREST (rpc)", "Sube por lotes las filas con sincronizado = false, aplica la respuesta por fila (aceptada, sibling o rechazada) y descarga por cursor. Corre como un trabajo único de WorkManager cuando hay señal.")
    Component(fotos, "DAT-06 Gestor de fotos", "FileProvider, conversión a WebP", "Captura y guarda la foto local, la convierte a WebP, la sube y descarga las de otros dispositivos.")
  }
}

ContainerDb(room, "Base de datos local", "Room 2.8 sobre SQLite")
Container(auth, "Supabase Auth", "GoTrue")
Container(rest, "API de datos", "PostgREST")
Container(storage, "Almacenamiento de fotos", "Supabase Storage")

Rel(uiEscanear, chapeta, "Lee el UID", "NFC-A")
Rel(bascula, srvPesaje, "Envía UID de la chapeta y peso", "HTTP/JSON, puerto 8080")

Rel(uiCuenta, domCuenta, "Crea la cuenta")
Rel(uiAnimales, domAnimales, "Registra, edita, da de baja y libera")
Rel(uiEscanear, domAnimales, "Resuelve el destino del código")
Rel(uiPesajes, domPesajes, "Asigna y descarta pendientes")
Rel(uiEventos, repos, "Observa eventos", "Flow")
Rel(uiEventos, domEventos, "Registra eventos")
Rel(uiEventos, domEventos, "Edita y da de baja", $tags="planificado")
Rel(uiFinca, funciones, "Invita, quita y crea la finca", $tags="planificado")
Rel(uiSync, motorSync, "Sincronizar ahora; consulta estado")
Rel(uiSync, domEventos, "Resuelve un conflicto")
Rel(uiInd, domInd, "Pide los indicadores")
Rel(uiAnimales, repos, "Observa animales e historial", "Flow")

Rel(srvPesaje, domPesajes, "Registra el pesaje recibido")
Rel(domCuenta, repos, "Guarda finca y usuario")
Rel(domAnimales, repos, "Lee y escribe")
Rel(domPesajes, repos, "Lee y escribe")
Rel(domEventos, repos, "Lee y escribe")
Rel(domInd, repos, "Lee")
Rel(domCuenta, sesion, "Inicia sesión y crea la identidad con la finca y la autorización")
Rel(domCuenta, funciones, "Canjea el código de invitación", $tags="planificado")

Rel(repos, room, "Lee y escribe", "SQL")
Rel(motorSync, repos, "Lee pendientes y aplica cambios")
Rel(motorSync, sesion, "Obtiene el JWT vigente")
Rel(motorSync, rest, "Llama subir_cambios y descargar_cambios", "HTTPS/JSON + JWT")
Rel(motorSync, fotos, "Sube y descarga fotos pendientes")
Rel(fotos, storage, "Sube y descarga WebP", "HTTPS + JWT")
Rel(sesion, auth, "Crea cuenta, inicia y renueva sesión", "HTTPS")
Rel(funciones, rest, "Llama las funciones", "HTTPS/JSON + JWT", $tags="planificado")

SHOW_LEGEND()
@enduml
