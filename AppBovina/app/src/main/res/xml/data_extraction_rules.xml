<?xml version="1.0" encoding="utf-8"?>
<!--
   Sin copia de seguridad ni traspaso entre dispositivos (RNF-13): los datos personales solo salen del celular
   hacia el proyecto Supabase de la finca, que ya los respalda. allowBackup="false" apaga la copia en la nube;
   este archivo apaga además el traspaso a un celular nuevo, que en Android 12 o superior no depende de él.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
